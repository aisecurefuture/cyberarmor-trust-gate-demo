# CyberArmor URL Trust Gate demo — environment template.
#
# install.sh copies this to .env and replaces every "change-me*" value with a
# freshly generated random secret. You normally never edit this by hand.
#
# This is a DEMO configuration: insecure defaults are allowed and everything
# binds to localhost. Do NOT use these settings in production.

# --- Secrets (auto-randomized by install.sh) ---
CYBERARMOR_JWT_SECRET=change-me-jwt
POLICY_API_KEY=change-me-policy
TELEMETRY_API_KEY=change-me-telemetry

# --- Demo mode ---
CYBERARMOR_ALLOW_INSECURE_DEFAULTS=true
# TLS listener stays off for the demo — services speak plain HTTP internally.
CYBERARMOR_ENABLE_NATIVE_TLS_LISTENER=false

# --- Networking ---
# Bind published ports to localhost only by default. Set to 0.0.0.0 to expose
# the gate API on the host's network (e.g. to demo from another machine).
HOST_BIND=127.0.0.1

# --- Data stores ---
POSTGRES_USER=cyberarmor
POSTGRES_PASSWORD=cyberarmor
POSTGRES_DB=cyberarmor
DATABASE_URL=postgresql://cyberarmor:cyberarmor@postgres:5432/cyberarmor
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
OPA_HOST_PORT=8181
POLICY_HOST_PORT=8001
AUDIT_HOST_PORT=8011

# --- Image tag ---
# Which published image tag to pull. REQUIRED -- docker-compose.yml reads
# ${IMAGE_TAG:?...}, so compose refuses to start when this is unset rather
# than falling back to a floating tag.
#
# PINNED ON PURPOSE, AND WHY THERE IS NO DEFAULT. This said `latest` until
# 2026-09-18, and `latest` was the only tag that existed, so there was nothing
# to pin to -- the demo ran whatever had last been pushed. On 2026-09-18 that
# was code from 2026-07-15, two months and 26 commits stale, and it was run in
# front of a prospective distributor before anyone noticed. Pinning fixed that
# clone; the compose DEFAULT still read `latest` until 2026-11-22.
#
# THE REGISTRY MOVED, 2026-11-22. These images are published from
# CyberArmor-AI/CyberArmorAI under ghcr.io/cyberarmor-ai/, not
# ghcr.io/aisecurefuture/. demo-images.yml must run under the account that owns
# the packages, and the aisecurefuture account schedules no Actions runners: a
# dispatched run sat 28 minutes with zero jobs and never moved, and `cancel`
# answered "cannot cancel a workflow run that has not been queued yet", while
# the org repo started three runs in the same window. A clone older than
# 2026-11-22 keeps pulling the stale ghcr.io/aisecurefuture/ images until it
# pulls this change.
#
# THIS TAG. 2026.11.22-a50137e, built from org main a50137ef57de
# (a50137ef57de957f28b7d870cf80eea1f2389d2d). All five images are stamped
# with that commit -- the build verifies it and fails if any disagrees:
#
#   docker inspect ghcr.io/cyberarmor-ai/cyberarmor-url-trust-gate:2026.11.22-a50137e \
#     --format '{{index .Config.Labels "org.opencontainers.image.revision"}}'
#
# It contains the fixes the 2026-09-18 build did not: #1097 (wildcard CORS
# across fourteen services, five of them in this demo), #837 (secure.login.gov
# blocked as credential phishing) and #836 (a sign-in page blocked for a
# sentence Google requires it to carry).
#
# Move this deliberately, to a tag you have seen pass.
IMAGE_TAG=2026.11.22-a50137e

# Where the images come from. Published by demo-images.yml in the CyberArmor
# monorepo; see that workflow for how a tag is produced.
REGISTRY=ghcr.io/cyberarmor-ai

# --- Optional reputation feeds (leave empty to skip) ---
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
