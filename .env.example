# CyberArmor URL Trust Gate demo — environment template.
#
# install.sh copies this to .env and replaces every "change-me*" value with a
# freshly generated random secret. You normally never edit this by hand.
#
# This is a DEMO configuration: insecure defaults are allowed and everything
# binds to localhost. Do NOT use these settings in production.

# --- Secrets (auto-randomized by install.sh) ---
CYBERARMOR_JWT_SECRET=change-me-jwt
POLICY_API_KEY=change-me-policy
TELEMETRY_API_KEY=change-me-telemetry

# --- Demo mode ---
CYBERARMOR_ALLOW_INSECURE_DEFAULTS=true
# TLS listener stays off for the demo — services speak plain HTTP internally.
CYBERARMOR_ENABLE_NATIVE_TLS_LISTENER=false

# --- Networking ---
# Bind published ports to localhost only by default. Set to 0.0.0.0 to expose
# the gate API on the host's network (e.g. to demo from another machine).
HOST_BIND=127.0.0.1

# --- Data stores ---
POSTGRES_USER=cyberarmor
POSTGRES_PASSWORD=cyberarmor
POSTGRES_DB=cyberarmor
DATABASE_URL=postgresql://cyberarmor:cyberarmor@postgres:5432/cyberarmor
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
OPA_HOST_PORT=8181
POLICY_HOST_PORT=8001
AUDIT_HOST_PORT=8011

# --- Image tag ---
# Which published image tag to pull. REQUIRED -- docker-compose.yml reads
# ${IMAGE_TAG:?...}, so compose refuses to start when this is unset rather
# than falling back to a floating tag.
#
# PINNED ON PURPOSE, AND WHY THE DEFAULT WAS REMOVED. This said `latest`
# until 2026-09-18, and `latest` was the only tag that existed, so there was
# nothing to pin to -- the demo ran whatever had last been pushed. On
# 2026-09-18 that was code from 2026-07-15, two months and 26 commits stale,
# and it was run in front of a prospective distributor before anyone noticed.
# Pinning fixed that clone. It did NOT fix the compose default, which still
# read `latest`, so any clone without a .env kept following a frozen pointer.
# That default is gone as of 2026-11-22.
#
# WHAT THIS TAG DOES NOT YET CONTAIN (read before demoing).
# 2026.09.18-84a0a97 is the only tag published to date -- demo-images.yml has
# run successfully exactly once, on 2026-09-18, and cannot run again until
# Actions are restored on the aisecurefuture account (no job has been
# scheduled there since 2026-10-04). Three fixes merged upstream after this
# build and are therefore NOT in these images:
#
#   * #1097 (2026-11-19) wildcard CORS across fourteen services. Five of them
#     are in this demo: policy, detection, audit, response, url-trust-gate.
#   * #837 (2026-11-07) secure.login.gov was blocked as credential phishing.
#   * #836 (2026-11-03) a sign-in page was blocked for a sentence Google
#     requires it to carry.
#
# SO: do not type a real sign-in URL into this build during a demo. The
# crafted fixtures in test-pages/ are unaffected -- they are bind-mounted,
# not baked into the images, so fixture fixes land on a git pull.
#
# When demo-images.yml next publishes, change this ONE line to the new tag.
# Move it deliberately, to a tag you have seen pass.
IMAGE_TAG=2026.09.18-84a0a97

# Where the images come from. Published by demo-images.yml in the
# CyberArmor monorepo; see that workflow for how a tag is produced.
REGISTRY=ghcr.io/aisecurefuture

# --- Optional reputation feeds (leave empty to skip) ---
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
